# Default is authenticated mode. "demo" serves public sample UI only; account APIs are disabled.
APP_MODE=auth
# Exact public origin, no trailing slash; production requires HTTPS.
APP_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pricedesk
DB_USER=pricedesk
DB_PASSWORD=
# Use verified TLS for a remote database that supports it.
DB_SSL=false
# For one-time CLI bootstrap only: set BOOTSTRAP_EMAIL, BOOTSTRAP_NAME,
# BOOTSTRAP_PASSWORD in a protected environment; remove them after use.

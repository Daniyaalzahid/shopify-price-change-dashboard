{
  "name": "shopify-price-change-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/manage.ts migrate",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/manage.ts bootstrap",
    "db:recover-admin": "node --env-file-if-exists=.env --import tsx scripts/manage.ts recover-admin",
    "db:cleanup": "node --env-file-if-exists=.env --import tsx scripts/manage.ts cleanup",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:auth-browser": "playwright test --config=playwright.auth.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "mysql2": "3.24.6",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
